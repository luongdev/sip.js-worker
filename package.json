{
  "name": "sip-worker.js",
  "version": "1.0.0",
  "description": "SIP.js WebRTC library with SharedWorker and ServiceWorker support for background call handling",
  "type": "module",
  "main": "dist/sip-worker.umd.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:worker": "tsc && vite build --config vite.worker.config.ts",
    "build:all": "npm run build && npm run build:worker",
    "build:dev": "npm run build -- --mode development && npm run build:worker -- --mode development",
    "build:prod": "npm run build -- --mode production && npm run build:worker -- --mode production",
    "build:obfuscated": "npm run build:prod && npm run obfuscate",
    "obfuscate": "node scripts/obfuscate.cjs",
    "restore": "node scripts/obfuscate.cjs restore",
    "prepare": "npm run build:prod",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:obfuscated"
  },
  "keywords": [
    "sip",
    "webrtc",
    "voip",
    "worker",
    "shared-worker",
    "service-worker",
    "sip.js"
  ],
  "author": "luongld.it@gmail.com",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luongld/sip-worker.js.git"
  },
  "bugs": {
    "url": "https://github.com/luongld/sip-worker.js/issues"
  },
  "homepage": "https://github.com/luongld/sip-worker.js#readme",
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/uuid": "^10.0.0",
    "javascript-obfuscator": "^4.1.1",
    "terser": "^5.43.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^3.7.3",
    "webpack-obfuscator": "^3.5.1"
  },
  "dependencies": {
    "sip.js": "^0.21.2",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
